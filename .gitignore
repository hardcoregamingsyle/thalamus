# Env files. *.local already covers .env.local, but the sync scripts run
# `git add -A`, so spell out the rest before a stray .env gets pushed public.
.env
.env.*
!.env.example

# Core dumps (a 70MB one got committed once — never again)
core
core.*
*.core

# wrangler pages dev local cache
.wrangler
